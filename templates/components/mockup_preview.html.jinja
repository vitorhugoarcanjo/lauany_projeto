{# templates/components/mockup_preview.html.jinja
   PREVIEW — rascunho ao vivo. Config vem do servidor (merge template+user).
   O JS assume daqui pra frente via Mockup.aplicar(). Nada é salvo sem clicar em Salvar.
#}

{% set _cfg = aparencia.config_final if aparencia and aparencia.config_final
              else (perfil.config_final if perfil and perfil.config_final else {}) %}
{% set _meta = escala_meta(_cfg) %}
{% set _links = perfil.links_preview if perfil and perfil.links_preview else [] %}

<script>window.ESCALA = {{ escala_tabela() | tojson }};</script>

<div class="mockup-preview">
    <div class="mockup-preview-header">
        <span class="mockup-preview-tag">
            <i class="fas fa-mobile-screen"></i> Preview ao vivo
        </span>
        <div class="mockup-preview-acoes">
            {% if url_publica %}
            <a href="{{ url_publica }}" target="_blank" rel="noopener noreferrer"
               class="mockup-acao mockup-acao-primaria"
               title="Abrir página real em nova aba">
                <i class="fas fa-external-link-alt"></i>
                <span>Abrir página</span>
            </a>
            {% endif %}
        </div>
    </div>

    <div class="mockup-celular">
        <div class="mockup-celular-notch"></div>

        <div class="mockup-celular-tela anim-{{ _meta.animacao }}" id="mockupTela"
             style="{{ escala_vars_style(_cfg, contexto='preview') }}">

            <div class="mockup-celular-foto" id="mockupFoto">
                {% if perfil and perfil.foto %}
                    <img src="{{ url_for('static', filename=perfil.foto) }}"
                         alt="Foto"
                         style="object-position: center {{ perfil.foto_posicao or 'top' }};">
                {% else %}
                    <i class="fas fa-user"></i>
                {% endif %}
            </div>

            <h2 class="mockup-celular-nome" id="mockupNome">
                {{ perfil.nome_display if perfil and perfil.nome_display else 'Seu nome' }}
            </h2>

            <p class="mockup-celular-bio" id="mockupBio">
                {{ perfil.bio if perfil and perfil.bio else 'Sua bio aparece aqui...' }}
            </p>

            <div class="mockup-celular-links" id="mockupLinks">
                {% if _links %}
                    {% for link in _links[:4] %}
                    <div class="mockup-celular-link" style="--i: {{ loop.index0 }};">
                        <i class="fas {{ link.icone or 'fa-link' }}"></i>
                        <span>{{ link.titulo }}</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="mockup-celular-link mockup-celular-link-vazio">
                        <i class="fas fa-link"></i>
                        <span>Seus links aparecem aqui</span>
                    </div>
                {% endif %}
            </div>

            <div class="mockup-celular-rodape">
                <i class="fas fa-link"></i> Feito pelo <strong>MeuLinks</strong>
            </div>
        </div>
    </div>

    <div class="mockup-preview-aviso">
        <i class="fas fa-info-circle"></i>
        Rascunho em tempo real. <strong>Nada é salvo</strong> até clicar em <em>Salvar</em>.
    </div>
</div>