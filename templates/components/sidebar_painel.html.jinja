{# templates/components/sidebar_painel.html.jinja #}
<aside class="sidebar" id="mainSidebar">

    <div class="sidebar-logo">
        <a href="{{ url_for('painel.ini_painel') }}">
            <i class="fas fa-link"></i>
            <span>Meu<span class="text-accent">Links</span></span>
        </a>
        <button class="sidebar-close" id="menuClose" aria-label="Fechar menu">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <nav class="sidebar-nav">
        <ul>
            <li>
                <a href="{{ url_for('painel.ini_painel') }}"
                   class="{% if request.endpoint == 'painel.ini_painel' %}active{% endif %}">
                    <i class="fas fa-home"></i> Início
                </a>
            </li>
            <li>
                <a href="{{ url_for('painel.perfil.tela_perfil') }}"
                   class="{% if request.endpoint == 'painel.perfil.tela_perfil' %}active{% endif %}">
                    <i class="fas fa-user"></i> Perfil
                </a>
            </li>
            <li>
                <a href="{{ url_for('painel.aparencia.tela_aparencia') }}"
                   class="{% if request.endpoint == 'painel.aparencia.tela_aparencia' %}active{% endif %}">
                    <i class="fas fa-palette"></i> Aparência
                </a>
            </li>
            <li>
                <a href="{{ url_for('links.ini_links') }}"
                   class="{% if request.endpoint == 'links.ini_links' %}active{% endif %}">
                    <i class="fas fa-link"></i> Meus links
                </a>
            </li>
            <li>
                <a href="{{ url_for('painel.config_painel.tela_config') }}"
                   class="{% if request.endpoint == 'painel.config_painel.tela_config' %}active{% endif %}">
                    <i class="fas fa-cog"></i> Configurações
                </a>
            </li>

            {# ⚠️ Painel Master (só aparece se for master) #}
            {% if session.get('is_master') %}
            <li class="sidebar-divisor"><hr></li>
            <li>
                <a href="{{ url_for('master.dashboard') }}"
                   class="sidebar-master-link {% if request.endpoint and request.endpoint.startswith('master.') %}active{% endif %}">
                    <i class="fas fa-crown"></i> Painel Master
                </a>
            </li>
            {% endif %}
        </ul>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <i class="fas fa-user-circle"></i>
            <span>{{ session.user_nome.split(' ')[0] if session.user_nome else 'Usuário' }}</span>
        </div>

        <a href="{{ url_for('painel.logout') }}" class="sidebar-logout">
            <i class="fas fa-sign-out-alt"></i> Sair
        </a>
    </div>

</aside>