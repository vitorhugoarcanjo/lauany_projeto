{# templates/pasta_painel/modulos/aparencia/tela_aparencia.html.jinja #}
{% extends 'tela_base_pos_login/base.html.jinja' %}

{% block titulo %}Aparência | MeuLinks{% endblock %}

{% block tela_header %}
<h1 class="tela-header-titulo">
    <i class="fas fa-wand-magic-sparkles"></i> Aparência
    <span class="tela-header-tag">Personalização</span>
</h1>
{% endblock %}

{% block footer_titulo %}APARÊNCIA{% endblock %}

{% block footer_esquerda %}
<button type="button" class="btn-footer btn-footer-primary" id="btnSalvarFooter">
    <i class="fas fa-save"></i>
    <span>SALVAR</span>
</button>
{% endblock %}

{% block conteudo %}
<section class="tela-grid">
    <div>
        <form id="formAparencia" class="aparencia-form">

            <!-- ==================== TEMPLATES ==================== -->
            <div class="tela-bloco">
                <div class="tela-bloco-titulo">
                    <i class="fas fa-star"></i>
                    <span>Templates prontos</span>
                </div>

                {#
                  ⚠️ Mapa global dos config_default (dict do Python → JSON limpo no <script>).
                  O tojson do Jinja é seguro DENTRO de <script>, e aqui o JS lê
                  window.__TEMPLATES_CONFIG__[slug] em vez de fazer JSON.parse
                  de um atributo HTML (que vem escapado com &quot;).
                #}
                <script>
                    window.__TEMPLATES_CONFIG__ = {
                        {% for t in templates %}
                        {{ t.slug | tojson }}: {{ t.config_default | tojson }}{% if not loop.last %},{% endif %}
                        {% endfor %}
                    };
                </script>

                <div class="templates-grid">
                    {% for t in templates %}
                    {# Fallback robusto pro inline (caso config_default venha como string) #}
                    {% set _cfg = t.config_default if t.config_default is mapping else {} %}
                    {% set _bg = _cfg.get('efeitos', {}).get('background')
                                 or _cfg.get('cores', {}).get('fundo')
                                 or '#f5f7fa' %}
                    <button type="button"
                            class="template-card {% if aparencia.template_slug == t.slug %}active{% endif %}"
                            data-template="{{ t.slug }}">
                        {# Classe template-preview-<slug> + inline style (redundância proposital) #}
                        <div class="template-preview template-preview-{{ t.slug }}"
                             style="background: {{ _bg }};"></div>
                        <span>{{ t.nome }}</span>
                    </button>
                    {% endfor %}
                </div>

                <input type="hidden" name="template_slug" id="template_slug_hidden"
                       value="{{ aparencia.template_slug }}">
            </div>

            <!-- ==================== CORES ==================== -->
            <div class="tela-bloco">
                <div class="tela-bloco-titulo">
                    <i class="fas fa-palette"></i>
                    <span>Cores</span>
                </div>

                <div class="cores-grid-2">
                    <div class="cor-item">
                        <label for="cor_primaria">Cor dos botões</label>
                        <div class="cor-input">
                            <input type="color" id="cor_primaria" name="cor_primaria"
                                   value="{{ aparencia.config_final.cores.primaria or '#3b82f6' }}">
                            <span class="cor-hex" id="corPrimariaHex">{{ aparencia.config_final.cores.primaria or '#3b82f6' }}</span>
                        </div>
                    </div>
                    <div class="cor-item">
                        <label for="cor_secundaria">Cor secundária</label>
                        <div class="cor-input">
                            <input type="color" id="cor_secundaria" name="cor_secundaria"
                                   value="{{ aparencia.config_final.cores.secundaria or '#06b6d4' }}">
                            <span class="cor-hex" id="corSecundariaHex">{{ aparencia.config_final.cores.secundaria or '#06b6d4' }}</span>
                        </div>
                    </div>
                    <div class="cor-item">
                        <label for="cor_fundo">Cor de fundo</label>
                        <div class="cor-input">
                            <input type="color" id="cor_fundo" name="cor_fundo"
                                   value="{{ aparencia.config_final.cores.fundo or '#f5f7fa' }}">
                            <span class="cor-hex" id="corFundoHex">{{ aparencia.config_final.cores.fundo or '#f5f7fa' }}</span>
                        </div>
                    </div>
                    <div class="cor-item">
                        <label for="cor_texto">Cor do texto</label>
                        <div class="cor-input">
                            <input type="color" id="cor_texto" name="cor_texto"
                                   value="{{ aparencia.config_final.cores.texto or '#1a1a1a' }}">
                            <span class="cor-hex" id="corTextoHex">{{ aparencia.config_final.cores.texto or '#1a1a1a' }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TAMANHOS E EFEITOS ==================== -->
            <div class="tela-bloco">
                <div class="tela-bloco-titulo">
                    <i class="fas fa-expand"></i>
                    <span>Tamanhos e efeitos</span>
                </div>

                <div class="config-grid-3">
                    <div class="form-grupo">
                        <label for="tamanho_foto">Foto de perfil</label>
                        <select id="tamanho_foto" name="tamanho_foto" class="form-select">
                            {% for valor, label in escala_tamanhos.foto %}
                            <option value="{{ valor }}"
                                {% if aparencia.config_final.layout.tamanho_foto == valor %}selected{% endif %}>
                                {{ label }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-grupo">
                        <label for="tamanho_link">Altura dos links</label>
                        <select id="tamanho_link" name="tamanho_link" class="form-select">
                            {% for valor, label in escala_tamanhos.link %}
                            <option value="{{ valor }}"
                                {% if aparencia.config_final.layout.tamanho_link == valor %}selected{% endif %}>
                                {{ label }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-grupo">
                        <label for="espacamento_links">Espaçamento entre links</label>
                        <select id="espacamento_links" name="espacamento_links" class="form-select">
                            {% for valor, label in escala_tamanhos.gap %}
                            <option value="{{ valor }}"
                                {% if aparencia.config_final.layout.espacamento_links == valor %}selected{% endif %}>
                                {{ label }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-grupo">
                        <label for="borda_link">Borda dos links</label>
                        <select id="borda_link" name="borda_link" class="form-select">
                            {% for valor, label in escala_tamanhos.borda %}
                            <option value="{{ valor }}"
                                {% if aparencia.config_final.layout.borda_link == valor %}selected{% endif %}>
                                {{ label }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-grupo">
                        <label for="hover_efeito">Efeito ao passar o mouse</label>
                        <select id="hover_efeito" name="hover_efeito" class="form-select">
                            {% for valor, label in escala_tamanhos.hover %}
                            <option value="{{ valor }}"
                                {% if aparencia.config_final.efeitos.hover_efeito == valor %}selected{% endif %}>
                                {{ label }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-grupo">
                        <label for="animacao_entrada">Animação de entrada</label>
                        <select id="animacao_entrada" name="animacao_entrada" class="form-select">
                            {% for valor, label in escala_tamanhos.anim %}
                            <option value="{{ valor }}"
                                {% if aparencia.config_final.efeitos.animacao_entrada == valor %}selected{% endif %}>
                                {{ label }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            <!-- ==================== TIPOGRAFIA ==================== -->
            <div class="tela-bloco">
                <div class="tela-bloco-titulo">
                    <i class="fas fa-font"></i>
                    <span>Tipografia</span>
                </div>

                <div class="config-grid-3">
                    <div class="form-grupo">
                        <label for="fonte">Fonte</label>
                        <select id="fonte" name="fonte" class="form-select">
                            {% for valor, label in escala_tamanhos.fonte %}
                            <option value="{{ valor }}"
                                {% if aparencia.config_final.tipografia.fonte == valor %}selected{% endif %}>
                                {{ label }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-grupo">
                        <label for="estilo_botao">Formato dos botões</label>
                        <select id="estilo_botao" name="estilo_botao" class="form-select">
                            {% for valor, label in escala_tamanhos.estilo %}
                            <option value="{{ valor }}"
                                {% if aparencia.config_final.tipografia.estilo_botao == valor %}selected{% endif %}>
                                {{ label }}
                            </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

        </form>
    </div>

    <div class="tela-preview-col">
        {% set url_publica = url_for('publico.pagina_publica', username=perfil.username)
                             if perfil and perfil.username else None %}
        {% include 'components/mockup_preview.html.jinja' %}
    </div>
</section>
{% endblock %}

{% block js_extra %}{% endblock %}