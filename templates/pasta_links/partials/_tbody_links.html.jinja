{# templates/pasta_links/partials/_tbody_links.html.jinja #}
{# Partial: <tbody> com todas as linhas da tabela #}
<tbody id="tbody-links">
    {% if links %}
        {% for link in links %}
            {% include 'pasta_links/partials/_linha_link.html.jinja' %}
        {% endfor %}
    {% else %}
        <tr>
            <td colspan="6" class="text-center py-4 text-white-50">
                Nenhum link cadastrado ou encontrado.
            </td>
        </tr>
    {% endif %}
</tbody>