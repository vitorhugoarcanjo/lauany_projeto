{# templates/pasta_links/partials/form_link.html.jinja #}
{# ==========================================================
   PARTIAL: Campos do formulário de link (novo + editar)
   Aceita `link` (dict) — se vier, preenche os campos.
   Sem IDs globais. Tudo via .js-* para o JS achar.
   ========================================================== #}

{% set l = link or {} %}

<div class="form-body">

    <!-- SELETOR DE TIPO -->
    <div class="form-grupo">
        <label>Tipo de link</label>
        <div class="tipo-selector js-tipo-selector">
            <button type="button" class="tipo-btn js-tipo-btn {% if not l.tipo or l.tipo == 'link' %}active{% endif %}" data-tipo="link">
                <i class="fas fa-link"></i>
                <span>Link</span>
            </button>
            <button type="button" class="tipo-btn js-tipo-btn {% if l.tipo == 'whatsapp' %}active{% endif %}" data-tipo="whatsapp">
                <i class="fab fa-whatsapp"></i>
                <span>WhatsApp</span>
            </button>
            <button type="button" class="tipo-btn js-tipo-btn {% if l.tipo == 'email' %}active{% endif %}" data-tipo="email">
                <i class="fas fa-envelope"></i>
                <span>E-mail</span>
            </button>
        </div>
        <input type="hidden" name="tipo" id="tipo" class="js-tipo" value="{{ l.tipo or 'link' }}">
    </div>

    <!-- TÍTULO -->
    <div class="form-grupo">
        <label for="titulo">Título <span class="obrigatorio">*</span></label>
        <input
            type="text"
            id="titulo"
            name="titulo"
            class="form-input js-titulo"
            placeholder="Ex: Meu site"
            maxlength="100"
            autocomplete="off"
            value="{{ l.titulo or '' }}"
            required
        >
    </div>

    <!-- ==================== CAMPO: LINK ==================== -->
    <div class="js-campo js-campo-link" {% if l.tipo and l.tipo != 'link' %}hidden{% endif %}>
        <div class="form-grupo">
            <label for="url">URL <span class="obrigatorio">*</span></label>
            <input
                type="url"
                id="url"
                name="url"
                class="form-input js-url"
                placeholder="https://..."
                maxlength="500"
                autocomplete="off"
                value="{{ l.url or '' }}"
            >
        </div>
    </div>

    <!-- ==================== CAMPO: WHATSAPP ==================== -->
    <div class="js-campo js-campo-whatsapp" {% if l.tipo != 'whatsapp' %}hidden{% endif %}>
        <div class="form-grupo">
            <label for="telefone">Telefone (com DDD e país) <span class="obrigatorio">*</span></label>
            <input
                type="tel"
                id="telefone"
                name="telefone"
                class="form-input js-telefone"
                placeholder="(11) 99999-9999"
                maxlength="20"
                autocomplete="tel"
                value="{{ l.telefone or '' }}"
            >
            <small class="form-hint">Brasil: DDD + número. Ex: (11) 99999-9999</small>
        </div>
        <div class="form-grupo">
            <label for="mensagem">Mensagem pré-preenchida <span class="opcional">(opcional)</span></label>
            <textarea
                id="mensagem"
                name="mensagem"
                class="form-input form-textarea js-mensagem"
                placeholder="Olá! Vim pelo seu link..."
                maxlength="300"
                rows="2"
            >{{ l.mensagem or '' }}</textarea>
            <small class="form-hint">Aparece já digitada no WhatsApp.</small>
        </div>
    </div>

    <!-- ==================== CAMPO: E-MAIL ==================== -->
    <div class="js-campo js-campo-email" {% if l.tipo != 'email' %}hidden{% endif %}>
        <div class="form-grupo">
            <label for="email_destino">E-mail <span class="obrigatorio">*</span></label>
            <input
                type="email"
                id="email_destino"
                name="email_destino"
                class="form-input js-email"
                placeholder="seu@email.com"
                maxlength="100"
                autocomplete="email"
                value="{{ l.email_destino or '' }}"
            >
        </div>
        <div class="form-grupo">
            <label for="assunto">Assunto <span class="opcional">(opcional)</span></label>
            <input
                type="text"
                id="assunto"
                name="assunto"
                class="form-input js-assunto"
                placeholder="Assunto do e-mail"
                maxlength="100"
                value="{{ l.assunto or '' }}"
            >
        </div>
    </div>

    <!-- DESCRIÇÃO -->
    <div class="form-grupo">
        <label for="descricao">Descrição <span class="opcional">(opcional)</span></label>
        <input
            type="text"
            id="descricao"
            name="descricao"
            class="form-input js-descricao"
            placeholder="Uma linha rápida sobre o link"
            maxlength="255"
            autocomplete="off"
            value="{{ l.descricao or '' }}"
        >
    </div>

    <!-- ÍCONE + ORDEM -->
    <div class="form-linha">

        <div class="form-grupo">
            <label for="icone">Ícone</label>
            <div class="input-com-preview">
                <span class="icone-preview">
                    <i class="fas {{ l.icone or 'fa-link' }} js-icone-preview"></i>
                </span>
                <input
                    type="text"
                    id="icone"
                    name="icone"
                    class="form-input js-icone"
                    placeholder="fa-link"
                    maxlength="50"
                    autocomplete="off"
                    value="{{ l.icone or 'fa-link' }}"
                >
            </div>
            <small class="form-hint">
                Classe do Font Awesome (sem o <code>fas</code>).
                Ex: <code>fa-link</code>, <code>fa-whatsapp</code>.
            </small>
        </div>

        <div class="form-grupo">
            <label for="ordem">Ordem</label>
            <input
                type="number"
                id="ordem"
                name="ordem"
                class="form-input js-ordem"
                value="{{ l.ordem or 0 }}"
                min="0"
                max="9999"
                inputmode="numeric"
            >
            <small class="form-hint">Menor número aparece primeiro.</small>
        </div>

    </div>

    <!-- CHECKBOXES -->
    <div class="form-checkboxes">

        <label class="checkbox-linha">
            <input
                type="checkbox"
                name="abrir_nova_aba"
                class="js-nova-aba"
                {% if l.abrir_nova_aba is not defined or l.abrir_nova_aba %}checked{% endif %}
            >
            <span>Abrir em nova aba</span>
        </label>

        <label class="checkbox-linha">
            <input
                type="checkbox"
                name="destaque"
                class="js-destaque"
                {% if l.destaque %}checked{% endif %}
            >
            <span>Destacar na página</span>
        </label>

    </div>

</div>