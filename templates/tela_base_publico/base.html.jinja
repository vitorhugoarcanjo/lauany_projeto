{# templates/tela_base_publico/base.html.jinja #}

{% set c = perfil.config_final if perfil and perfil.config_final else {} %}
{% set cores = c.cores if c.cores else {} %}
{% set tipografia = c.tipografia if c.tipografia else {} %}
{% set layout = c.layout if c.layout else {} %}
{% set efeitos = c.efeitos if c.efeitos else {} %}

{# O usuário escolheu cor de fundo? (sobrescreve o gradiente do template) #}
{% set user_escolheu_fundo = perfil.config and perfil.config.cores and perfil.config.cores.fundo %}

<!DOCTYPE html>
<html lang="pt-BR" data-tema="{{ 'escuro' if cores.texto and cores.texto in ['#f0f0f0', '#ffffff', '#fff'] else 'claro' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block titulo %}{{ perfil.titulo_pagina or perfil.nome_display }}{% endblock %}</title>
    <meta name="description" content="{% block descricao %}{{ perfil.meta_descricao or perfil.bio or 'Meus links' }}{% endblock %}">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="{{ static_v('css/modules/pasta_publico/publico.min.css') }}">

    {% block css_extra %}{% endblock %}

    <style>
        :root {
            --perfil-cor-primaria: {{ cores.primaria or '#3b82f6' }};
            --perfil-cor-secundaria: {{ cores.secundaria or '#06b6d4' }};
            --perfil-cor-fundo: {{ cores.fundo or '#f5f7fa' }};
            --perfil-cor-texto: {{ cores.texto or '#1a1a1a' }};
            --perfil-foto-posicao: {{ perfil.foto_posicao or 'top' }};

            {% set raios = {'arredondado': '12px', 'quadrado': '4px', 'pilula': '999px'} %}
            --perfil-raio-link: {{ raios.get(tipografia.estilo_botao or 'arredondado', '12px') }};

            {% set fotos = {'pequena': '112px', 'medio': '144px', 'grande': '176px'} %}
            --perfil-foto-tamanho: {{ fotos.get(layout.tamanho_foto or 'medio', '144px') }};

            {% set links = {'pequeno': '48px', 'medio': '56px', 'grande': '64px'} %}
            --perfil-link-tamanho: {{ links.get(layout.tamanho_link or 'medio', '56px') }};

            {% set gaps = {'compacto': '8px', 'medio': '14px', 'espacoso': '20px'} %}
            --perfil-gap: {{ gaps.get(layout.espacamento_links or 'medio', '14px') }};

            {% set bordas = {'sem': '0px', 'fina': '2px', 'media': '3px', 'grossa': '4px'} %}
            --perfil-borda-tamanho: {{ bordas.get(layout.borda_link or 'media', '3px') }};

            --perfil-hover-transform: {% if efeitos.hover_efeito == 'subir' %}translateY(-4px){% elif efeitos.hover_efeito == 'escalar' %}scale(1.03){% elif efeitos.hover_efeito == 'brilho' %}none{% else %}none{% endif %};
            --perfil-hover-brilho: {% if efeitos.hover_efeito == 'brilho' %}brightness(1.15){% else %}none{% endif %};
        }

        {% if efeitos.animacao_entrada == 'fade' %}
        .perfil-link { opacity: 0; transform: translateY(20px); animation: fadeInUp 0.6s forwards; }
        .perfil-link:nth-child(1) { animation-delay: 0.1s; }
        .perfil-link:nth-child(2) { animation-delay: 0.2s; }
        .perfil-link:nth-child(3) { animation-delay: 0.3s; }
        .perfil-link:nth-child(4) { animation-delay: 0.4s; }
        .perfil-link:nth-child(5) { animation-delay: 0.5s; }
        .perfil-link:nth-child(6) { animation-delay: 0.6s; }
        @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }
        {% elif efeitos.animacao_entrada == 'slide' %}
        .perfil-link { opacity: 0; transform: translateX(-30px); animation: slideIn 0.5s forwards; }
        .perfil-link:nth-child(1) { animation-delay: 0.1s; }
        .perfil-link:nth-child(2) { animation-delay: 0.2s; }
        .perfil-link:nth-child(3) { animation-delay: 0.3s; }
        .perfil-link:nth-child(4) { animation-delay: 0.4s; }
        .perfil-link:nth-child(5) { animation-delay: 0.5s; }
        @keyframes slideIn { to { opacity: 1; transform: translateX(0); } }
        {% elif efeitos.animacao_entrada == 'scale' %}
        .perfil-link { opacity: 0; transform: scale(0.85); animation: scaleIn 0.5s forwards; }
        .perfil-link:nth-child(1) { animation-delay: 0.1s; }
        .perfil-link:nth-child(2) { animation-delay: 0.2s; }
        .perfil-link:nth-child(3) { animation-delay: 0.3s; }
        .perfil-link:nth-child(4) { animation-delay: 0.4s; }
        .perfil-link:nth-child(5) { animation-delay: 0.5s; }
        @keyframes scaleIn { to { opacity: 1; transform: scale(1); } }
        {% endif %}
    </style>
</head>
<body class="publico-body template-{{ perfil.template_slug or 'cosmic' }} estilo-botao-{{ tipografia.estilo_botao or 'arredondado' }} fonte-{{ tipografia.fonte or 'padrao' }} hover-{{ efeitos.hover_efeito or 'subir' }}"
      {% if efeitos.background and not user_escolheu_fundo %}
      style="background: {{ efeitos.background }};"
      {% endif %}>

    <main class="publico-main">
        {% block conteudo %}{% endblock %}
    </main>

    <footer class="pub-rodape-fixo">
        <a href="https://meulinks.com.br" target="_blank" rel="noopener noreferrer">
            <i class="fas fa-bolt"></i>
            <span>Feito pelo <strong>MeuLinks</strong></span>
        </a>
    </footer>

    {% block js_extra %}{% endblock %}
</body>
</html>