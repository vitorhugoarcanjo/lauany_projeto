{# templates/pasta_login/pasta_cadastre_se/tela_confirmar_email.html.jinja #}
{% extends 'tela_base_pre_login/base.html.jinja' %}

{% block titulo %}Confirmar e-mail | MeuLinks{% endblock %}

{% block conteudo %}
<div class="auth-container">

    <div class="auth-card">

        <div class="auth-card-header">
            <h1 class="auth-titulo">
                <i class="fas fa-envelope-open-text"></i>
                Confirme seu e-mail
            </h1>
            <p class="auth-subtitulo">
                Enviamos um código de 6 dígitos pra você.<br>
                Digite abaixo pra ativar sua conta.
            </p>
        </div>

        <!-- Aviso sobre spam -->
        <div class="aviso-spam">
            <i class="fas fa-triangle-exclamation"></i>
            <span>Não achou o e-mail? Verifica a caixa de <strong>spam</strong> ou <strong>lixeira</strong>.</span>
        </div>

        <form id="formConfirmarEmail" class="auth-form">
            <input type="hidden" name="user_id" value="{{ user_id }}">

            <div class="form-grupo">
                <label for="codigo">Código de 6 dígitos</label>
                <input
                    type="text"
                    id="codigo"
                    name="codigo"
                    class="input-codigo"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    placeholder="000000"
                    autocomplete="one-time-code"
                    autofocus
                >
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="btnVerificar">
                <span class="btn-texto">Verificar código</span>
                <span class="btn-loading">
                    <i class="fas fa-spinner fa-spin"></i> Verificando...
                </span>
            </button>

        </form>

        <div class="auth-actions">
            <a href="{{ url_for('cadastre_se.reenviar_codigo', user_id=user_id) }}" class="auth-link" id="linkReenviar">
                Reenviar código
            </a>
            <span class="auth-sep">·</span>
            <a href="{{ url_for('cadastre_se.tela_cadastre_se') }}" class="auth-link">
                Voltar
            </a>
        </div>

    </div>

</div>

<!-- OVERLAY DE LOADING -->
<div class="overlay-loading" id="overlayLoading">
    <div class="spinner"></div>
    <div class="texto">Verificando código...</div>
    <div class="subtexto">Validando seu e-mail</div>
    <div class="barra-progresso"></div>
</div>
{% endblock %}

{% block js_extra %}
<script src="{{ static_v('js/modules/pasta_auth/auth.min.js') }}" defer></script>
{% endblock %}