{# templates/pasta_login/recuperar_senha/tela_validar_codigo.html.jinja #}
{% extends 'tela_base_pre_login/base.html.jinja' %}

{% block titulo %}Verificar código | MeuLinks{% endblock %}

{% block conteudo %}
<div class="auth-container">

    <div class="auth-card">

        <div class="auth-card-header">
            <h1 class="auth-titulo">
                <i class="fas fa-shield-halved"></i>
                Código enviado
            </h1>
            <p class="auth-subtitulo">
                Enviamos um código de 6 dígitos pra<br>
                <strong>{{ email }}</strong>
            </p>
        </div>

        <form method="POST" class="auth-form">

            <div class="form-grupo">
                <label for="codigo">Código de 6 dígitos</label>
                <input
                    type="text"
                    id="codigo"
                    name="codigo"
                    class="input-codigo"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    placeholder="000000"
                    autocomplete="one-time-code"
                    autofocus
                    required
                >
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                Verificar
            </button>

        </form>

        <div class="auth-actions">
            <a href="{{ url_for('recuperar.solicitar_recuperacao') }}" class="auth-link">
                Solicitar novo código
            </a>
        </div>

    </div>

</div>
{% endblock %}